{
  "name": "senor-mano-website",
  "version": "1.0.0",
  "description": "Website para acceder fácilmente a los cuadernillos de español",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "prebuild": "node generate-markdown-imports.js",
    "build": "remix vite:build",
    "dev": "concurrently \"npm run watch-markdown\" \"remix vite:dev\" --names \"watcher,dev\" --prefix-colors \"cyan,green\"",
    "dev:simple": "remix vite:dev",
    "watch-markdown": "node watch-markdown.js",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve build/server/index.js",
    "typecheck": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@fontsource/delius": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@remix-run/dev": "^2.17.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "react-router-dom": "^7.18.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "estree-util-value-to-estree": "^3.3.3",
      "undici@6": "^6.29.1",
      "js-yaml": "^4.3.2",
      "toml": "^5.0.1",
      "tar": "^7.5.18",
      "vite@5": "^6.4.4",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "body-parser@1": "^1.20.9",
      "qs": "^6.16.1",
      "morgan": "^1.12.1",
      "postcss-selector-parser@7": "^7.1.6",
      "react-router@6": "^6.30.6",
      "react-router-dom@6": "^6.30.6",
      "@babel/core@7": "^7.29.6",
      "browserslist": "^4.28.7",
      "postcss": "^8.5.18",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.2",
      "turbo-stream": "^3.0.0"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.17.0"
}
